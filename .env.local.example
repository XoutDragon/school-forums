# Copy to .env.local. These are not secrets: NEXT_PUBLIC_/VITE_ values ship to the
# browser, and the deployment name identifies the project without granting access —
# that comes from being authenticated to the Convex team.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:colorful-stoat-16

NEXT_PUBLIC_CONVEX_URL=https://colorful-stoat-16.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://colorful-stoat-16.convex.cloud

# The client is Vite, not Next. Vite only exposes VITE_-prefixed variables to
# browser code, so these are the names the app actually reads.
VITE_CONVEX_URL=https://colorful-stoat-16.convex.cloud
VITE_CONVEX_SITE_URL=https://colorful-stoat-16.convex.cloud
