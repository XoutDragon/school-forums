// CampusConnect — Lakeshore University
//
// SQLite has no native enum type and no scalar lists, so every `@shared enum` field below
// is a String whose allowed values live in shared/src/schemas/common.ts. That Zod enum is
// the source of truth; validate at the edge, trust the string in here.
// Same story for arrays and grids: stored as JSON strings, parsed in the service layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── Identity ────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  username     String    @unique
  displayName  String
  avatarUrl    String?
  bio          String?
  pronouns     String?
  year         String? // @shared YearEnum
  majorId      String?
  minorId      String?
  karma        Int       @default(0)
  settings     String    @default("{}") // @shared UserSettings (JSON)
  isAdmin      Boolean   @default(false)
  lastSeenAt   DateTime  @default(now())
  verifiedAt   DateTime? // auto-set locally; the field exists so real verification can slot in
  onboardedAt  DateTime?
  deletedAt    DateTime? // anonymise, never hard-delete (§8)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  major Major? @relation("UserMajor", fields: [majorId], references: [id])
  minor Major? @relation("UserMinor", fields: [minorId], references: [id])

  interests         UserInterest[]
  courses           UserCourse[]
  spaceMemberships  SpaceMember[]
  messages          Message[]
  reactions         Reaction[]
  dmMemberships     DirectMember[]
  directMessages    DirectMessage[]
  pinnedMessages    PinnedMessage[]
  clubMemberships   ClubMembership[]
  reviews           CourseReview[]
  resources         Resource[]
  resourceVotes     ResourceVote[]
  qaPosts           QAPost[]
  qaAnswers         QAAnswer[]
  qaVotes           QAVote[]
  ownedStudyGroups  StudyGroup[]
  studyGroupSeats   StudyGroupMember[]
  buddyProfile      BuddyProfile?
  matchesA          BuddyMatch[]       @relation("MatchUserA")
  matchesB          BuddyMatch[]       @relation("MatchUserB")
  rsvps             EventRSVP[]
  listings          MarketplaceListing[]
  lostFoundItems    LostFoundItem[]
  mentorProfile     MentorProfile?
  mentorLinks       MentorLink[]       @relation("Mentor")
  menteeLinks       MentorLink[]       @relation("Mentee")
  reportsFiled      Report[]           @relation("Reporter")
  reportsResolved   Report[]           @relation("Resolver")
  modActionsTaken   ModerationAction[] @relation("Moderator")
  modActionsAgainst ModerationAction[] @relation("TargetUser")
  notifications     Notification[]
  badges            UserBadge[]
  wavesSent         Wave[]             @relation("WaveFrom")
  wavesReceived     Wave[]             @relation("WaveTo")
  ownedSpaces       Space[]            @relation("SpaceOwner")
  channelReads      ChannelRead[]

  @@index([majorId])
  @@index([year])
}

model Major {
  id          String   @id @default(cuid())
  name        String   @unique
  faculty     String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usersMajoring User[]   @relation("UserMajor")
  usersMinoring User[]   @relation("UserMinor")
  courses       Course[]
  spaces        Space[]
}

model Interest {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String // @shared InterestCategoryEnum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
}

model UserCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  term      String
  status    String // @shared CourseStatusEnum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, term])
  @@index([courseId, term])
}

// ────────────────────────────────────────────────────────── Spaces & Chat ────

model Space {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  iconUrl       String?
  bannerUrl     String?
  type          String // @shared SpaceTypeEnum
  visibility    String   @default("PUBLIC") // @shared VisibilityEnum
  ownerId       String
  linkedClubId  String?  @unique
  linkedCourseId String?
  linkedMajorId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner        User      @relation("SpaceOwner", fields: [ownerId], references: [id])
  linkedClub   Club?     @relation("ClubSpace", fields: [linkedClubId], references: [id])
  linkedCourse Course?   @relation(fields: [linkedCourseId], references: [id])
  linkedMajor  Major?    @relation(fields: [linkedMajorId], references: [id])

  members    SpaceMember[]
  channels   Channel[]
  resources  Resource[]
  qaPosts    QAPost[]
  studyGroup StudyGroup?

  @@index([type])
  @@index([linkedCourseId])
  @@index([linkedMajorId])
}

model SpaceMember {
  id       String   @id @default(cuid())
  spaceId  String
  userId   String
  role     String   @default("MEMBER") // @shared SpaceRoleEnum
  nickname String?
  joinedAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
}

model Channel {
  id        String   @id @default(cuid())
  spaceId   String
  name      String
  topic     String?
  type      String   @default("TEXT") // @shared ChannelTypeEnum
  position  Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  messages Message[]
  pins     PinnedMessage[]
  reads    ChannelRead[]

  @@unique([spaceId, name])
  @@index([spaceId, position])
}

model Message {
  id           String    @id @default(cuid())
  channelId    String
  authorId     String? // retained for anonymous posts; NEVER serialised when isAnonymous
  content      String
  attachments  String    @default("[]") // JSON Attachment[]
  replyToId    String?
  threadRootId String?
  isAnonymous  Boolean   @default(false)
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  channel Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User?     @relation(fields: [authorId], references: [id])
  replyTo Message?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies Message[] @relation("MessageReply")

  reactions Reaction[]
  pin       PinnedMessage?

  @@index([channelId, createdAt])
  @@index([threadRootId])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model PinnedMessage {
  id          String   @id @default(cuid())
  channelId   String
  messageId   String   @unique
  pinnedById  String
  createdAt   DateTime @default(now())

  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User    @relation(fields: [pinnedById], references: [id])

  @@index([channelId])
}

/// Per-user read cursor. Drives unread badges without scanning the whole message table.
model ChannelRead {
  id            String   @id @default(cuid())
  channelId     String
  userId        String
  lastReadAt    DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model DirectConversation {
  id        String   @id @default(cuid())
  title     String? // group DMs only
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  DirectMember[]
  messages DirectMessage[]
}

model DirectMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  authorId       String
  content        String
  attachments    String    @default("[]")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
}

// ───────────────────────────────────────────────────────────────── Clubs ────

model Club {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String
  category            String // @shared ClubCategoryEnum
  logoUrl             String?
  meetingInfo         String?
  socialLinks         String   @default("{}") // JSON
  memberCountEstimate Int      @default(0)
  isRecruiting        Boolean  @default(true)
  tags                String   @default("[]") // JSON string[] — powers the club quiz (§5.4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  space       Space?           @relation("ClubSpace")
  memberships ClubMembership[]

  @@index([category])
}

model ClubMembership {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String   @default("MEMBER") // @shared ClubRoleEnum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

// ──────────────────────────────────────────────── Courses & Knowledge ────

model Course {
  id            String   @id @default(cuid())
  code          String   @unique
  title         String
  description   String?
  majorId       String?
  level         Int
  avgDifficulty Float?
  avgWorkload   Float?
  avgRating     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  major Major? @relation(fields: [majorId], references: [id])

  enrolments  UserCourse[]
  reviews     CourseReview[]
  resources   Resource[]
  qaPosts     QAPost[]
  studyGroups StudyGroup[]
  listings    MarketplaceListing[]
  spaces      Space[]

  @@index([majorId])
  @@index([level])
}

model CourseReview {
  id             String   @id @default(cuid())
  courseId       String
  authorId       String
  term           String
  profName       String
  difficulty     Int
  workload       Int
  rating         Int
  tips           String
  wouldRecommend Boolean
  showName       Boolean  @default(false)
  helpfulCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([courseId, authorId, term])
  @@index([courseId, term])
}

model Resource {
  id            String   @id @default(cuid())
  courseId      String?
  spaceId       String?
  uploaderId    String
  title         String
  description   String?
  type          String // @shared ResourceTypeEnum
  fileUrl       String?
  linkUrl       String?
  term          String?
  downloadCount Int      @default(0)
  score         Int      @default(0) // denormalised sum of votes; kept in step by the service
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  space    Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  votes ResourceVote[]

  @@index([courseId, score])
  @@index([spaceId])
}

model ResourceVote {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  value      Int // +1 / -1
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
}

model QAPost {
  id               String   @id @default(cuid())
  courseId         String?
  spaceId          String?
  authorId         String
  title            String
  body             String
  score            Int      @default(0)
  acceptedAnswerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  space    Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  accepted QAAnswer? @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id])

  answers QAAnswer[] @relation("PostAnswers")

  @@index([courseId])
  @@index([spaceId])
}

model QAAnswer {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   QAPost @relation("PostAnswers", fields: [postId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  acceptedOn QAPost? @relation("AcceptedAnswer")
  votes      QAVote[]

  @@index([postId])
}

model QAVote {
  id        String   @id @default(cuid())
  answerId  String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  answer QAAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
}

// ─────────────────────────────────────────────── Study & Social Matching ────

model StudyGroup {
  id           String   @id @default(cuid())
  courseId     String?
  spaceId      String?  @unique
  name         String
  description  String?
  maxSize      Int      @default(6)
  meetingType  String   @default("IN_PERSON") // @shared MeetingTypeEnum
  schedule     String   @default("[]") // JSON boolean[35]
  locationHint String?
  ownerId      String
  status       String   @default("OPEN") // @shared StudyGroupStatusEnum
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members StudyGroupMember[]

  @@index([courseId, status])
}

model StudyGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  status    String   @default("MEMBER") // MEMBER | REQUESTED
  createdAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model BuddyProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  isActive     Boolean  @default(true)
  lookingFor   String   @default("[]") // JSON LookingFor[]
  availability String   @default("[]") // JSON boolean[35]
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuddyMatch {
  id          String   @id @default(cuid())
  userAId     String
  userBId     String
  score       Int
  explanation String // §5.6 makes this mandatory — a match you can't explain isn't shown
  status      String   @default("SUGGESTED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userA User @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

/// Low-pressure "I see you" ping (§5.3). Mutual waves prompt both sides to open a DM.
model Wave {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  context   String? // e.g. "CS 2210" or a major id — why they showed up to each other
  createdAt DateTime @default(now())

  from User @relation("WaveFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("WaveTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
}

// ──────────────────────────────────────────────────────────────── Events ────

model Event {
  id             String   @id @default(cuid())
  title          String
  description    String?
  hostType       String // @shared HostTypeEnum
  hostId         String
  startsAt       DateTime
  endsAt         DateTime
  location       String
  locationDetail String?
  capacity       Int?
  coverUrl       String?
  tags           String   @default("[]") // JSON string[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rsvps EventRSVP[]

  @@index([startsAt])
  @@index([hostType, hostId])
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String // @shared RsvpStatusEnum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────── Campus Utility ────

model MarketplaceListing {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String?
  priceCents  Int
  category    String // @shared ListingCategoryEnum
  courseId    String?
  photos      String   @default("[]") // JSON string[]
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([category, status])
  @@index([courseId])
}

model LostFoundItem {
  id          String   @id @default(cuid())
  reporterId  String
  kind        String // LOST | FOUND
  title       String
  description String
  location    String
  photoUrl    String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
}

model MentorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  isMentor  Boolean  @default(true)
  capacity  Int      @default(3)
  topics    String   @default("[]") // JSON string[]
  blurb     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentorLink {
  id        String   @id @default(cuid())
  mentorId  String
  menteeId  String
  status    String   @default("REQUESTED")
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor User @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee User @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
  @@index([menteeId])
}

// ─────────────────────────────────────────────────────── Trust & Safety ────

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  targetType   String // @shared ReportTargetEnum
  targetId     String
  reason       String
  status       String   @default("OPEN")
  resolvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reporter   User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("Resolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

model ModerationAction {
  id           String    @id @default(cuid())
  moderatorId  String
  targetUserId String
  type         String // WARN | MUTE | KICK | BAN | CONTENT_REMOVED
  scope        String? // spaceId, or null for global
  reason       String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  moderator  User @relation("Moderator", fields: [moderatorId], references: [id])
  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([scope])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   String    @default("{}") // JSON
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ────────────────────────────────────────────────────── Karma & Badges ────

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  emoji       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  awards UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}
