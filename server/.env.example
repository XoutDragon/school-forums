# Copy to server/.env before running `npm run db:migrate`.
# All values below are safe local defaults except JWT_SECRET.

DATABASE_URL="file:../dev.db"

# Any string 16+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-random-32-byte-hex-string"

SERVER_PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
