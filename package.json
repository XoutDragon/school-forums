{
  "name": "campusconnect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n convex,client -c magenta,cyan \"npm:convex:dev\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w shared && npm run build -w client",
    "test": "npm run test -w client",
    "test:client": "npm run test -w client",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:seed": "convex run seed:run"
  },
  "_overridesNote": "vitest pulls its own vite, which npm installs beside the client's copy. Two vites means two sets of incompatible plugin types, so vite is pinned for the whole tree.",
  "overrides": {
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "convex": "^1.44.0",
    "lucide-react": "^1.33.0"
  }
}
